;;; sync-queries.el --- Embed generated Roc highlighting queries -*- lexical-binding: t; -*-

;;; Commentary:
;; Evaluate (roc-ts-sync-queries SOURCE OUTPUT TAG) in Emacs to embed the
;; generated Emacs highlights.scm from the pinned tree-sitter-roc tag.

;;; Code:

(require 'subr-x)

(defun roc-ts--check-query-content (source tag)
  "Reject executable callback captures, predicates, or stale tags in SOURCE.
TAG is the expected grammar tag.  Ignore full-line query comments."
  (when (and (not (equal tag "2026-10-20.01"))
             (string-match-p "2026-10-20\\.01" source))
    (error "SOURCE contains the previous grammar tag"))
  (dolist (line (split-string source "\n"))
    (unless (string-match-p "\\`[[:space:]]*;" line)
      (when (string-match-p
             "@roc-ts--fontify\\|#\\(?:match\\|eq\\|not-match\\)\\?"
             line)
        (error "SOURCE contains a callback capture or predicate: %s" line)))))

(defun roc-ts-sync-queries (source output tag)
  "Embed SOURCE into OUTPUT after verifying the pinned grammar TAG.
Keep every feature section in order, including repeated feature names."
  (let* ((source (expand-file-name source))
         (output (expand-file-name output))
         (mode-file (expand-file-name "roc-ts-mode.el"
                                      (file-name-directory output)))
         (pin (with-temp-buffer
                (insert-file-contents mode-file)
                (goto-char (point-min))
                (unless (re-search-forward
                         "\"https://github\\.com/Giesch/tree-sitter-roc/\"[[:space:]]+\"\\([^\"]+\\)\""
                         nil t)
                  (error "Cannot find Roc grammar pin in %s" mode-file))
                (match-string-no-properties 1)))
         (root (string-trim
                (with-temp-buffer
                  (unless (eq 0 (process-file "git" nil t nil "-C"
                                              (file-name-directory source)
                                              "rev-parse" "--show-toplevel"))
                    (error "SOURCE is not inside a Git checkout: %s" source))
                  (buffer-string))))
         (relative (file-relative-name source root))
         (sections nil)
         (header "^;; feature: \\([[:alnum:]-]+\\)[ \t]*$"))
    (unless (and (string-match-p "\\`[0-9]\\{4\\}-[0-9]\\{2\\}-[0-9]\\{2\\}\\.[0-9][0-9]\\'" tag)
                 (equal tag pin))
      (error "TAG %s does not match pinned grammar tag %s" tag pin))
    (unless (equal relative "queries-generated/emacs/queries/highlights.scm")
      (error "SOURCE is not the generated Emacs highlights query: %s" source))
    (let ((actual (with-temp-buffer
                    (insert-file-contents-literally source)
                    (buffer-string)))
          (tagged (with-temp-buffer
                    (unless (eq 0 (process-file "git" nil t nil "-C" root
                                                "show" (concat tag ":" relative)))
                      (error "Cannot read tagged highlights query for %s" tag))
                    (buffer-string))))
      (unless (equal actual tagged)
        (error "SOURCE differs from tree-sitter-roc tag %s" tag))
      (roc-ts--check-query-content actual tag))
    (with-temp-buffer
      (insert-file-contents source)
      (goto-char (point-min))
      (unless (re-search-forward header nil t)
        (error "No feature sections in %s" source))
      (when (string-match-p "[^[:space:]]"
                            (buffer-substring-no-properties (point-min)
                                                            (line-beginning-position)))
        (error "Unexpected content before first feature in %s" source))
      (let ((feature (intern (match-string-no-properties 1))))
        (while feature
          (forward-line 1)
          (let* ((start (point))
                 (next (re-search-forward header nil t))
                 (next-feature (when next (intern (match-string-no-properties 1))))
                 (end (if next (line-beginning-position) (point-max)))
                 (query (string-trim
                         (buffer-substring-no-properties start end))))
            (when (string-empty-p query)
              (error "Empty feature section %s in %s" feature source))
            (push (cons feature (concat query "\n")) sections)
            (setq feature next-feature)))))
    (with-temp-file output
      (insert ";;; roc-ts-queries.el --- Generated Roc font-lock queries -*- lexical-binding: t; -*-\n\n")
      (insert (format ";;; Commentary:\n;; Generated by scripts/sync-queries.el from tree-sitter-roc tag %s.\n\n;;; Code:\n\n" tag))
      (insert "(defconst roc-ts--generated-font-lock-queries\n  '")
      (let ((print-length nil)
            (print-level nil)
            (print-circle nil)
            (print-escape-newlines t)
            (print-escape-nonascii t))
        (prin1 (nreverse sections) (current-buffer)))
      (insert "\n")
      (insert (format "  \"Generated from tree-sitter-roc %s.  Do not edit.\")\n\n" tag))
      (insert "(provide 'roc-ts-queries)\n\n;;; roc-ts-queries.el ends here\n"))))

(provide 'sync-queries)

;;; sync-queries.el ends here
